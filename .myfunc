# sort df
function sdf() {
    df -h | sort -r -h -k 2 | grep dev | grep -v "loop"
}

function unset_proxy {
    unset http_proxy
    unset https_proxy
    unset HTTP_PROXY
    unset HTTPS_PROXY
    unset all_proxy
}

alias fdate='date +"%Y%m%d_%H%M%S"'

pdfcat() {
    if [ $# -eq 0 ]; then
        echo "用法: pdfcat <PDF文件路径>"
        echo "示例: pdfcat ./Downloads/2605.11005v1.pdf"
        return 1
    fi

    pdftotext -layout "$1" -
}

echo_eval() {
  echo ">>> $1"
  eval $1
}

function zhihu_answer_render() {
  zhihu answer $1 --json | jq -r ".content" | pandoc -f html -t gfm-raw_html --wrap=none | sd
}
alias zar=zhihu_answer_render
alias za="zhihu answer"
alias zf="zhihu feed"
alias zhl="zhihu hot -l"
alias html2md="pandoc -f html -t gfm-raw_html --wrap=none"

source $HOME/.ai.api_base_key

RENDER=$(command -v sd || echo "cat")

ai_translate_text() {
  local input_text="$1"
  local model="${2:-deepseek-v4-flash}"
  local max_tokens="${3:-16384}"  # 输出长度为 16k
  local temperature="${4:-1.0}"  # 默认温度为 1.0

  # 使用 jq 生成合法的 JSON 请求体
  local json_payload=$(jq -n \
    --arg input_text "$input_text" \
    --arg model "$model" \
    --argjson max_tokens "$max_tokens" \
    --argjson temperature "$temperature" \
    '{
    model: $model,
    messages: [
      {
        role: "system",
        content: "You are a translation expert. You will translate the following messages into Chinese and do not add any other explanations."
      },
      {
        role: "user",
        content: $input_text
      }
    ],
    max_tokens: $max_tokens,
    temperature: $temperature
  }')

  # 发送请求
  curl -X POST $OPENAI_API_BASE \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer ${OPENAI_API_KEY}" \
    -d "$json_payload" | \
  jq -r ".choices[0].message.content // .error.message" | \
  $RENDER
}


ai_ask() {
  local input_text="$1"
  local model="${2:-deepseek-v4-flash}"
  local max_tokens="${3:-16384}"  # 默认输出为 16k
  local temperature="${4:-1.0}"  # 默认温度为 1.0

  # 使用 jq 生成合法的 JSON 请求体
  local json_payload=$(jq -n \
    --arg input_text "$input_text" \
    --arg model "$model" \
    --argjson max_tokens "$max_tokens" \
    --argjson temperature "$temperature" \
    '{
    model: $model,
    messages: [
      {
        role: "system",
        content: "You are a helpful assistant."
      },
      {
        role: "user",
        content: $input_text
      }
    ],
    max_tokens: $max_tokens,
    temperature: $temperature
  }')

  # 发送请求
  curl -sX POST $OPENAI_API_BASE \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer ${OPENAI_API_KEY}" \
    -d "$json_payload" | \
  jq -r ".choices[0].message.content // .error.message" | \
  $RENDER
}

ai_ask_stream () {
    local input_text="$1"
    local model="${2:-deepseek-v4-flash}"
    local max_tokens="${3:-16384}"
    local temperature="${4:-1.0}"

    local json_payload=$(jq -n \
        --arg input_text "$input_text" \
        --arg model "$model" \
        --argjson max_tokens "$max_tokens" \
        --argjson temperature "$temperature" \
        '{
            model: $model,
            messages: [
              {role: "system", content: "You are a helpful assistant."},
              {role: "user",   content: $input_text}
            ],
            max_tokens: $max_tokens,   # ← 转成数字
            temperature: $temperature,
            stream: true
        }')

    curl -s -X POST "$OPENAI_API_BASE" \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer ${OPENAI_API_KEY}" \
        -d "$json_payload" -N \
      | sed -u -e 's/^data:[[:space:]]*//g' -e '/^\[DONE\]/d' \
      | jq --unbuffered -j \
          ".choices[0].message.content // .choices[0].delta.content // .error.message // .message // empty" \
      | $RENDER
}

alias tt=ai_translate_text
alias ask=ai_ask
alias sask=ai_ask_stream

moonshot_balance() {
  curl https://api.moonshot.cn/v1/users/me/balance -H "Authorization: Bearer $MOONSHOT_API_KEY"
}

moonshot_models() {
  curl https://api.moonshot.cn/v1/models -H "Authorization: Bearer $MOONSHOT_API_KEY"
}

