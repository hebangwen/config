#!/usr/bin/env python3
"""
知乎日报 CLI 工具

用法：
    python3 zhihu_daily.py latest          # 获取今日日报列表
    python3 zhihu_daily.py day 20260629    # 获取指定日期当天的日报
    python3 zhihu_daily.py story 9789487   # 获取文章详情（Markdown 格式）
    python3 zhihu_daily.py week            # 获取近 7 天日报列表
"""

import argparse
import json
import os
import re
import sys
import urllib.request
from datetime import date as dt, timedelta
from html.parser import HTMLParser

ZHIHU_BASE = "https://daily.zhihu.com/api/4"
WEEKDAYS = ["一", "二", "三", "四", "五", "六", "日"]


# ──────────────────────────────────────────────────────────────
# HTML → Markdown 转换器
# ──────────────────────────────────────────────────────────────

class HTML2Markdown(HTMLParser):
    """简单的 HTML → Markdown 转换，覆盖知乎日报常见标签。"""

    def __init__(self):
        super().__init__()
        self.output = []
        self.current_tag = None
        self.tag_stack = []
        self.list_level = 0
        self.in_blockquote = False
        self.skip_tags = {"script", "style", "head", "meta", "link"}
        self.skip_depth = 0

    def handle_starttag(self, tag, attrs):
        attrs_dict = dict(attrs)
        self.tag_stack.append(tag)
        self.current_tag = tag

        if tag in self.skip_tags:
            self.skip_depth += 1
            return

        if self.skip_depth > 0:
            return

        if tag == "h1":
            self.output.append("\n# ")
        elif tag == "h2":
            self.output.append("\n## ")
        elif tag == "h3":
            self.output.append("\n### ")
        elif tag == "h4":
            self.output.append("\n#### ")
        elif tag == "p":
            self.output.append("\n\n")
        elif tag == "br":
            self.output.append("\n")
        elif tag == "strong" or tag == "b":
            self.output.append("**")
        elif tag == "em" or tag == "i":
            self.output.append("*")
        elif tag == "a":
            href = attrs_dict.get("href", "")
            self.output.append("[")
            self._link_href = href
        elif tag == "img":
            src = attrs_dict.get("src", "")
            alt = attrs_dict.get("alt", "")
            self.output.append(f"\n![{alt}]({src})\n")
        elif tag == "ul" or tag == "ol":
            self.list_level += 1
            self.output.append("\n")
            self._list_counter = 0 if tag == "ol" else -1
        elif tag == "li":
            indent = "  " * (self.list_level - 1)
            if self._list_counter >= 0:
                self._list_counter += 1
                self.output.append(f"{indent}{self._list_counter}. ")
            else:
                self.output.append(f"{indent}- ")
        elif tag == "blockquote":
            self.in_blockquote = True
            self.output.append("\n> ")
        elif tag == "code":
            self.output.append("`")
        elif tag == "pre":
            self.output.append("\n```\n")
        elif tag == "hr":
            self.output.append("\n---\n")

    def handle_endtag(self, tag):
        if self.tag_stack:
            self.tag_stack.pop()

        if tag in self.skip_tags:
            self.skip_depth -= 1
            return

        if self.skip_depth > 0:
            return

        if tag == "strong" or tag == "b":
            self.output.append("**")
        elif tag == "em" or tag == "i":
            self.output.append("*")
        elif tag == "a":
            href = getattr(self, "_link_href", "")
            self.output.append(f"]({href})")
        elif tag == "ul" or tag == "ol":
            self.list_level -= 1
            self.output.append("\n")
        elif tag == "li":
            self.output.append("\n")
        elif tag == "blockquote":
            self.in_blockquote = False
            self.output.append("\n")
        elif tag == "code":
            self.output.append("`")
        elif tag == "pre":
            self.output.append("\n```\n")
        elif tag in ("h1", "h2", "h3", "h4"):
            self.output.append("\n")
        elif tag == "p":
            pass  # 下一个 <p> 会加换行

    def handle_data(self, data):
        if self.skip_depth > 0:
            return
        text = data
        if self.in_blockquote:
            text = text.replace("\n", "\n> ")
        self.output.append(text)

    def get_markdown(self):
        result = "".join(self.output)
        # 清理多余空行
        result = re.sub(r"\n{3,}", "\n\n", result)
        return result.strip()


def html_to_markdown(html_str: str) -> str:
    """将 HTML 字符串转换为 Markdown。"""
    if not html_str:
        return ""
    parser = HTML2Markdown()
    parser.feed(html_str)
    return parser.get_markdown()


# ──────────────────────────────────────────────────────────────
# API 请求
# ──────────────────────────────────────────────────────────────

def api_get(path: str) -> dict:
    """请求知乎日报 API，返回 JSON。"""
    url = ZHIHU_BASE + path
    req = urllib.request.Request(url, headers={"User-Agent": "zhihu-daily-cli/1.0"})
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        print(f"❌ 请求失败: {url}\n   {e}", file=sys.stderr)
        sys.exit(1)


def parse_date(date_str: str) -> dt:
    """将 YYYYMMDD 解析为 date。"""
    return dt(int(date_str[:4]), int(date_str[4:6]), int(date_str[6:8]))


def shift_date(date_str: str, days: int) -> str:
    """将 YYYYMMDD 偏移指定天数后返回 YYYYMMDD。"""
    return (parse_date(date_str) + timedelta(days=days)).strftime("%Y%m%d")


def format_date(date_str: str) -> str:
    """将 YYYYMMDD 格式化为可读日期。"""
    d = parse_date(date_str)
    wd = WEEKDAYS[d.weekday()]
    return f"{d.month}月{d.day}日（周{wd}）"


# ──────────────────────────────────────────────────────────────
# 列表渲染
# ──────────────────────────────────────────────────────────────

def print_day_list(data: dict):
    """输出单日日报列表。"""
    print(f"# 📰 知乎日报 · {format_date(data['date'])}\n")
    for i, s in enumerate(data["stories"], 1):
        hint = f" — {s['hint']}" if s.get("hint") else ""
        print(f"{i}. **{s['title']}**{hint}")
        print(f"   ID: {s['id']}  |  `{os.path.basename(sys.argv[0])} story {s['id']}`")
        print()


# ──────────────────────────────────────────────────────────────
# 子命令实现
# ──────────────────────────────────────────────────────────────

def cmd_latest(args):
    """获取今日最新日报列表。"""
    data = api_get("/news/latest")
    print_day_list(data)


def cmd_day(args):
    """获取指定日期当天的日报。"""
    date = args.date
    if len(date) != 8 or not date.isdigit():
        print("❌ 日期格式错误，应为 YYYYMMDD（如 20260629）", file=sys.stderr)
        sys.exit(1)

    data = api_get(f"/news/before/{shift_date(date, 1)}")
    print_day_list(data)


def cmd_story(args):
    """获取文章详情，输出 Markdown 格式。"""
    story_id = args.id
    data = api_get(f"/news/{story_id}")

    title = data.get("title", "无标题")
    hint = data.get("hint", "")
    body_html = data.get("body", "")
    share_url = data.get("share_url", "")
    image = data.get("image", "")

    print(f"# {title}\n")
    if hint:
        print(f"> {hint}\n")
    if share_url:
        print(f"🔗 原文链接: {share_url}\n")
    if image:
        print(f"![题图]({image})\n")
    print("---\n")

    # 将 HTML body 转为 Markdown
    md_body = html_to_markdown(body_html)
    print(md_body)


def cmd_week(args):
    """获取近 7 天的日报列表。"""
    latest = api_get("/news/latest")
    days = [{"date": latest["date"], "stories": latest.get("stories", [])}]

    d = latest["date"]
    for _ in range(6):
        try:
            data = api_get(f"/news/before/{d}")
            if not data.get("date"):
                break
            days.append({"date": data["date"], "stories": data.get("stories", [])})
            d = data["date"]
        except SystemExit:
            break

    print("# 📰 知乎日报 · 近 7 天\n")
    for day in days:
        print(f"## {format_date(day['date'])}\n")
        for i, s in enumerate(day["stories"], 1):
            hint = f" — {s['hint']}" if s.get("hint") else ""
            print(f"{i}. **{s['title']}**{hint}")
            print(f"   ID: {s['id']}")
        print()


# ──────────────────────────────────────────────────────────────
# CLI 入口
# ──────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        prog=os.path.basename(sys.argv[0]),
        description="📰 知乎日报 CLI — 获取日报列表和文章详情（Markdown 输出）",
    )
    subparsers = parser.add_subparsers(dest="command", help="可用子命令")

    # latest
    sp_latest = subparsers.add_parser("latest", help="获取今日最新日报列表")
    sp_latest.set_defaults(func=cmd_latest)

    # day
    sp_day = subparsers.add_parser("day", help="获取指定日期当天的日报（YYYYMMDD）")
    sp_day.add_argument("date", help="日期，格式 YYYYMMDD（返回该日期当天的内容）")
    sp_day.set_defaults(func=cmd_day)

    # story
    sp_story = subparsers.add_parser("story", help="获取文章详情（Markdown 格式）")
    sp_story.add_argument("id", help="文章 ID")
    sp_story.set_defaults(func=cmd_story)

    # week
    sp_week = subparsers.add_parser("week", help="获取近 7 天日报列表")
    sp_week.set_defaults(func=cmd_week)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(0)

    args.func(args)


if __name__ == "__main__":
    main()
